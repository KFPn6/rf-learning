---
# 公開ページのみ。404、この XML、運営用 docs/、アセットは出さない。
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | sort: "url" -%}
{%- for page in pages -%}
{%- assign path = page.path | default: "" -%}
{%- assign loc = page.url | default: "" -%}
{%- if loc contains ".xml" or loc contains ".css" or loc contains ".js" or loc contains ".svg" or loc contains ".html" or loc contains ".scss" or loc contains ".png" or loc contains ".jpg" or loc contains ".gif" or loc contains ".webp" or loc contains ".pdf" or loc contains ".ico" or loc contains ".txt" or loc contains ".json" or path contains "docs/" or loc contains "/docs/" or path contains "assets/" or loc contains "/assets/" -%}
{%- else %}
  <url>
    <loc>{{ loc | absolute_url | xml_escape }}</loc>
  </url>
{% endif -%}
{%- endfor %}
</urlset>
